# dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# build output
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Vendored binaries and the manifest generated from them.
# manifest.json records size/sha256 of the files on disk. Lua's wasm is not
# byte-stable on Apple Silicon, so a committed Linux manifest must not be
# checked back out over a locally built binary.
# The Rust toolchain is committed (both files are under GitHub's 100 MB limit).
# Ignore the directory contents, then put those three paths back.
wasm/*
!wasm/rust/
wasm/rust/*
!wasm/rust/rustc.wasm
!wasm/rust/sysroot-wasip1.bundle
!wasm/rust/SOURCES.md

# third-party source and toolchain caches (clone / vendor separately, see README)
thirdparty/runno/
thirdparty/cache/

# tests / artifacts
tests/screenshots/
tests/*.png
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
