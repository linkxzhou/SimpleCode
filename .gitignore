# dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# build output
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# vendored language binaries — regenerate with ./build.sh vendor (manifest is tracked)
wasm/*
!wasm/manifest.json

# third-party source (clone separately, see README)
thirdparty/runno/

# tests / artifacts
tests/screenshots/
tests/*.png
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
